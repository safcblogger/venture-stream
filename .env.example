# --- Database (local dev matches docker-compose.yml) ---
DATABASE_URL=postgres://venture:venture_dev_password@localhost:5433/venture_stream
# Used only by `npm test` (a separate database that tests wipe). Create it with: npm run db:test:create
TEST_DATABASE_URL=postgres://venture:venture_dev_password@localhost:5433/venture_stream_test

# --- Sessions ---
# Public origin of the app, used for CSRF origin checks and cookie flags. No trailing slash.
APP_URL=http://localhost:3000

# --- AI provider (server-side only) ---
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Web search provider (server-side only) ---
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# --- Background worker ---
# Set to "false" to disable the in-process job worker (e.g. when running a dedicated worker).
WORKER_ENABLED=true
