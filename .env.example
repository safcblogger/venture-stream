# --- Database (local dev matches docker-compose.yml) ---
DATABASE_URL=postgres://venture:venture_dev_password@localhost:5433/venture_stream
# Used only by `npm test`; the tests drop and recreate this database on every run.
TEST_DATABASE_URL=postgres://venture:venture_dev_password@localhost:5433/venture_stream_test

# --- Sessions ---
# Public origin of the app, used for CSRF origin checks and cookie flags. No trailing slash.
APP_URL=http://localhost:3100

# Set to "false" to close public sign-up (existing users can still sign in and be invited).
ALLOW_REGISTRATION=true

# --- AI provider (server-side only) ---
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional: point at an OpenAI-compatible gateway.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Web search provider (server-side only) ---
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# TAVILY_BASE_URL=https://api.tavily.com

# --- Background worker ---
# Set to "false" to disable the in-process job worker (e.g. when running a dedicated worker).
WORKER_ENABLED=true
